{
	"layer": "top",
	"position": "bottom",
	"height": 24,
	"spacing": 0,
	"modules-left": [
		"sway/workspaces"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"cpu",
		"memory",
		"battery",
		"clock",
		"tray"
	],
	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": false,
		"format": "{name}"
	},
	"clock": {
		"interval": 1,
		"timezone": "Europe/Riga",
		"format": "{:%d.%m.%Y  %H:%M:%S}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "BAT: {capacity}%",
		"format-charging": "CHR: {capacity}%",
		"format-plugged": "PLG: {capacity}%",
		"format-full": "Full",
		"tooltip-format": "{timeTo}  ·  {power:.1f}W"
	},
	"cpu": {
		"format": "CPU: {usage}%",
		"interval": 3,
		"tooltip": false
	},
	"memory": {
		"format": "MEM: {percentage}%",
		"interval": 5,
		"tooltip-format": "{used:0.1f}G / {total:0.1f}G"
	},
	"network": {
		"format-wifi": "WIFI: {essid}",
		"format-ethernet": "ETH: {ifname}",
		"format-disconnected": "offline",
		"tooltip-format-wifi": "{signalStrength}%  ·  {ipAddr}",
		"max-length": 20
	},
	"pulseaudio": {
		"format": "VOL: {volume}%",
		"format-muted": "VOL: muted",
		"on-click": "pavucontrol",
		"scroll-step": 5
	},
	"tray": {
		"spacing": 8,
		"icon-size": 14
	}
}
